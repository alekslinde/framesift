{
  "name": "renamely",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin for renaming frames and their child layers to a consistent convention.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "pretest": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
